# Railway PostgreSQL — zkopírujte z Railway dashboard → Connect → Postgres URL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# NewsAPI — https://newsapi.org → Register → API key
NEWS_API_KEY="your_newsapi_key_here"

# Anthropic API — https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY="your_anthropic_api_key_here"

# Cron bezpečnostní token — vygenerujte libovolný náhodný řetězec, nastavte i ve Vercel
CRON_SECRET="your_random_secret_here"

# ACLED — https://acleddata.com → přihlašovací email a heslo z vašeho (zdarma) účtu
# Stahuje týdenní agregovaný Excel soubor (nevyžaduje placené API)
ACLED_EMAIL="vas@email.cz"
ACLED_PASSWORD="your_acled_password_here"

# ReliefWeb — https://apidoc.reliefweb.int/parameters#appname → vyžádat appname přes Google Form
RELIEFWEB_APPNAME="KBC_RiskResearch_x7abP3KJ"

# World Monitor — https://worldmonitor.app → API key z účtu
WORLDMONITOR_API_KEY="your_worldmonitor_api_key_here"

# OpenSky Network — volitelné, zvyšuje rate limit (výchozí: anonymní přístup zdarma)
# Registrace: https://opensky-network.org/index.php?option=com_users&view=registration
OPENSKY_CLIENT_ID="your_opensky_username"
OPENSKY_CLIENT_SECRET="your_opensky_password"

# RapidAPI — https://rapidapi.com → registrace → API Key v dashboard
# Používá se pro: SkyLink NOTAM API (1 000 req/měsíc zdarma)
RAPIDAPI_KEY="your_rapidapi_key_here"
